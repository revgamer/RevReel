<Window x:Class="RevReel.Views.AreaBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Focusable="False" ShowActivated="False" IsHitTestVisible="False">

    <!-- Outline only. The middle stays see-through. -->
    <Border BorderBrush="{StaticResource RecordBrush}" BorderThickness="3" Background="Transparent" />
</Window>
