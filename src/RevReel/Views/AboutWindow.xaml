<Window x:Class="RevReel.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About RevReel" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <StackPanel Margin="28">
        <TextBlock Text="RevReel" FontSize="30" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="VersionText" FontSize="14" Margin="0,4,0,0"
                   Foreground="{StaticResource AccentBrush}" />
        <TextBlock x:Name="ReleaseText" FontSize="12" Margin="0,2,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <Border Height="1" Margin="0,16" Background="{StaticResource SecondaryBrush}" />

        <TextBlock Text="A simple Windows screen recorder." FontSize="13"
                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="CompanyText" FontSize="13" Margin="0,10,0,0"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="CopyrightText" FontSize="12" Margin="0,2,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="LicenseText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />

        <TextBlock Text="Third-party software" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,0"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="ScreenRecorderLib - MIT License" FontSize="12" Margin="0,2,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />

        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Content="_GitHub" Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Click="GitHubButton_Click" AutomationProperties.Name="Open RevReel on GitHub" />
            <Button Content="_License" Style="{StaticResource SecondaryButton}" Padding="14,7"
                    Margin="10,0,0,0" Click="LicenseButton_Click"
                    AutomationProperties.Name="Open the license on GitHub" />
            <Button Content="_Close" Style="{StaticResource PrimaryButton}" Padding="14,7"
                    Margin="10,0,0,0" IsDefault="True" IsCancel="True" Click="CloseButton_Click"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </StackPanel>
</Window>
