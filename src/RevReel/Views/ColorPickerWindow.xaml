<Window x:Class="RevReel.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colour picker - RevReel" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Colour field: left to right is saturation, top to bottom is brightness -->
        <Border Grid.Column="0" Width="258" Height="258" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1">
            <Grid x:Name="SvArea" Width="256" Height="256" Background="Red" Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="SvArea_MouseLeftButtonDown" MouseMove="SvArea_MouseMove"
                  MouseLeftButtonUp="SvArea_MouseLeftButtonUp"
                  AutomationProperties.Name="Colour field. Left to right changes saturation, top to bottom changes brightness. You can also type the values on the right.">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvMarkerOuter" Width="14" Height="14" Stroke="Black" StrokeThickness="1" />
                    <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue bar -->
        <Border Grid.Column="2" Width="26" Height="258" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1">
            <Grid x:Name="HueArea" Width="24" Height="256" Cursor="Hand" ClipToBounds="False"
                  MouseLeftButtonDown="HueArea_MouseLeftButtonDown" MouseMove="HueArea_MouseMove"
                  MouseLeftButtonUp="HueArea_MouseLeftButtonUp"
                  AutomationProperties.Name="Hue bar. Top to bottom changes the colour.">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker" Width="24" Height="5" Stroke="Black" StrokeThickness="1" Fill="White" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Numbers -->
        <StackPanel Grid.Column="4" Width="250">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border x:Name="NewSwatch" Width="100" Height="62" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1"
                            HorizontalAlignment="Left" AutomationProperties.Name="New colour" />
                    <Border x:Name="OldSwatch" Width="100" Height="30" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1,0,1,1"
                            HorizontalAlignment="Left" AutomationProperties.Name="Current colour" />
                    <TextBlock Text="New (top) and current (bottom)" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Button Content="OK" Padding="10,6" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
                    <Button Content="Cancel" Margin="0,8,0,0" Padding="10,6" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="H" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="HBox" Grid.Row="0" Grid.Column="1" Margin="0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Hue, 0 to 360 degrees" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="°" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Grid.Row="1" Text="S" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="SBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Saturation, 0 to 100 percent" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="%" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="VBox" Grid.Row="2" Grid.Column="1" Margin="0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Brightness, 0 to 100 percent" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="%" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Grid.Row="3" Text="R" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="RBox" Grid.Row="3" Grid.Column="1" Margin="0,10,0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Red, 0 to 255" />

                <TextBlock Grid.Row="4" Text="G" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="GBox" Grid.Row="4" Grid.Column="1" Margin="0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Green, 0 to 255" />

                <TextBlock Grid.Row="5" Text="B" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="BlueBox" Grid.Row="5" Grid.Column="1" Margin="0,2" Padding="3" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Blue, 0 to 255" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="#" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="HexBox" Width="90" Margin="6,0,0,0" Padding="4,3" FontFamily="Consolas" FontSize="14" MaxLength="7"
                         KeyDown="Field_KeyDown" LostFocus="Field_LostFocus"
                         AutomationProperties.Name="Colour code, six letters or numbers" />
            </StackPanel>

            <TextBlock x:Name="HelpText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                       Text="Click or drag in the colour field and the hue bar, or type numbers and press Enter. H is hue, S is saturation, B is brightness." />
        </StackPanel>
    </Grid>
</Window>
