<Window x:Class="RevReel.Views.AreaSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select an area to record"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Cursor="Cross" Focusable="True"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        SizeChanged="Window_SizeChanged">

    <!-- One of these covers each monitor. The screen is dimmed; the chosen
         area is left bright and outlined, with its size written beside it. -->
    <Grid>
        <Path x:Name="DimMask" Fill="#AA000000" IsHitTestVisible="False" />

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRect" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                       Visibility="Collapsed" />
            <Border x:Name="SizeTag" Visibility="Collapsed" Background="{StaticResource AccentBrush}"
                    CornerRadius="4" Padding="8,3">
                <TextBlock x:Name="SizeTagText" Foreground="White" FontSize="13" FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border Background="#EE232831" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2"
                CornerRadius="10" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="MonitorLabel" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click and drag to choose the area to record."
                           Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="Keyboard: arrow keys move the box, Shift + arrow keys resize it, Enter uses it, Esc cancels."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="ReadoutText" Text="No area chosen yet." FontSize="13"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,48">
            <Button x:Name="ConfirmButton" Content="_Use this area" Style="{StaticResource PrimaryButton}"
                    Padding="18,9" IsEnabled="False" Click="ConfirmButton_Click" />
            <Button Content="_Cancel" Style="{StaticResource SecondaryButton}" Padding="18,9" Margin="12,0,0,0"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
