<Window x:Class="RevReel.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Focusable="False" IsHitTestVisible="False">

    <!-- Small pop-up message in the screen corner. It never takes the focus,
         ignores the mouse, and is hidden from screen recordings. -->
    <Border Margin="10" Padding="16,12" CornerRadius="10"
            Background="#F2232831" BorderBrush="#FF6A00" BorderThickness="2,0,0,0">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,10,0"
                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText" FontSize="14" MaxWidth="440" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
